{
  "schema": "rasq.settings-page/1",
  "area": "appearance.timeline",
  "title": "@l10n:settingsPagesAppearanceTimelineTitle",
  "defaults": {
    "newPostsPill": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAppearanceTimelineSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "edgeTiles",
        "p": {
          "title": "@l10n:settingsPagesAppearanceTimelineEdgeTilesTitle",
          "subtitle": "@l10n:settingsPagesAppearanceTimelineEdgeTilesSubtitle",
          "value": "$.settings.edgeTiles",
          "detail": "@l10n:settingsPagesAppearanceTimelineEdgeTilesDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "newPostsPill",
        "p": {
          "title": "@l10n:settingsPagesAppearanceTimelineNewPostsPillTitle",
          "subtitle": "@l10n:settingsPagesAppearanceTimelineNewPostsPillSubtitle",
          "value": "$.settings.newPostsPill",
          "detail": "@l10n:settingsPagesAppearanceTimelineNewPostsPillDetail"
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
