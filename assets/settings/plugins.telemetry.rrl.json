{
  "schema": "rasq.settings-page/1",
  "area": "plugins.telemetry",
  "title": "@l10n:settingsPagesPluginsTelemetryTitle",
  "defaults": {
    "fetchShapes": false
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesPluginsTelemetrySection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "fetchShapes",
        "p": {
          "title": "@l10n:settingsPagesPluginsTelemetryFetchShapesTitle",
          "value": "$.settings.fetchShapes",
          "subtitle": "@l10n:settingsPagesPluginsTelemetryFetchShapesSubtitle",
          "detail": "@l10n:settingsPagesPluginsTelemetryFetchShapesDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesPluginsTelemetryText1",
          "style": "caption",
          "detail": {"$l10n": "settingsPagesPluginsTelemetryText1Detail", "args": {"example": "{host: misskey.example, method: POST, path: /api/users/{hex}/notes, headers: [content-type], body: {i: s, limit: n}}"}}
        }
      }
    ]
  }
}
