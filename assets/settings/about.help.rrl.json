{
  "schema": "rasq.settings-page/1",
  "area": "about.help",
  "title": "@l10n:settingsPagesAboutHelpTitle",
  "defaults": {},
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpSection1Title"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesAboutHelpText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesAboutHelpText1Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/rai",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpRaiTitle"
        },
        "on": {
          "tap": "route.push"
        }
      },
      {
        "t": "ListTile",
        "k": "/tour?again=1",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpTourAgain1Title",
          "subtitle": "@l10n:settingsPagesAboutHelpTourAgain1Subtitle"
        },
        "on": {
          "tap": "route.push"
        }
      },
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpSection2Title"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesAboutHelpText2",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesAboutHelpText2Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/dsl/sns.security",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpSettingsDslSnsSecurityTitle"
        },
        "on": {
          "tap": "route.push"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/server",
        "p": {
          "title": "@l10n:settingsPagesAboutHelpSettingsServerTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
