{
  "schema": "rasq.settings-page/1",
  "area": "relational.plugins",
  "title": "@l10n:settingsPagesRelationalPluginsTitle",
  "defaults": {},
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesRelationalPluginsSection1Title"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "@l10n:settingsPagesRelationalPluginsValueRow1Title",
          "value": "@l10n:settingsPagesRelationalPluginsValueRow1Value"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesRelationalPluginsText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesRelationalPluginsText1Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/server",
        "p": {
          "title": "@l10n:settingsPagesRelationalPluginsSettingsServerTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
