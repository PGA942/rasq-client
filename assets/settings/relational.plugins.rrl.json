{
  "schema": "rasq.settings-page/1",
  "area": "relational.plugins",
  "title": "プラグインの詳細設定",
  "defaults": {},
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "状態"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "プラグイン枠",
          "value": "準備中"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "この画面のプラグインは準備中です。",
          "pad": 16,
          "size": 13,
          "detail": "リレーショナルタイムライン用のプラグイン枠(束ね方の差し替え)は契約 v0.7 にはまだありません。ML の類似度は RASQ サーバーの ML ゲートウェイを使います。 プラグイン枠: 未定義。"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/server",
        "p": {
          "title": "RASQ サーバーの接続先"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
