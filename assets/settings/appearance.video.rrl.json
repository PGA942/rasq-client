{
  "schema": "rasq.settings-page/1",
  "area": "appearance.video",
  "title": "@l10n:settingsPagesAppearanceVideoTitle",
  "defaults": {
    "autoplay": true,
    "defaultSpeed": "1.0",
    "pipKeepPosition": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAppearanceVideoSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "autoplay",
        "p": {
          "title": "@l10n:settingsPagesAppearanceVideoAutoplayTitle",
          "value": "$.settings.autoplay",
          "subtitle": "@l10n:settingsPagesAppearanceVideoAutoplaySubtitle",
          "detail": "@l10n:settingsPagesAppearanceVideoAutoplayDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "pipKeepPosition",
        "p": {
          "title": "@l10n:settingsPagesAppearanceVideoPipKeepPositionTitle",
          "value": "$.settings.pipKeepPosition",
          "subtitle": "@l10n:settingsPagesAppearanceVideoPipKeepPositionSubtitle"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAppearanceVideoSection2Title"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultSpeed",
        "p": {
          "title": "0.75×",
          "value": "0.75",
          "group": "$.settings.defaultSpeed"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultSpeed",
        "p": {
          "title": "@l10n:settingsPagesAppearanceVideoDefaultSpeed10Title",
          "value": "1.0",
          "group": "$.settings.defaultSpeed"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultSpeed",
        "p": {
          "title": "1.25×",
          "value": "1.25",
          "group": "$.settings.defaultSpeed"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultSpeed",
        "p": {
          "title": "1.5×",
          "value": "1.5",
          "group": "$.settings.defaultSpeed"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultSpeed",
        "p": {
          "title": "2.0×",
          "value": "2.0",
          "group": "$.settings.defaultSpeed"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesAppearanceVideoText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesAppearanceVideoText1Detail"
        }
      }
    ]
  }
}
