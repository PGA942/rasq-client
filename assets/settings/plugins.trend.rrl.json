{
  "schema": "rasq.settings-page/1",
  "area": "plugins.trend",
  "title": "@l10n:settingsPagesPluginsTrendTitle",
  "defaults": {
    "enabled": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesPluginsTrendSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "enabled",
        "p": {
          "title": "@l10n:settingsPagesPluginsTrendEnabledTitle",
          "value": "$.settings.enabled",
          "subtitle": "@l10n:settingsPagesPluginsTrendEnabledSubtitle",
          "detail": "@l10n:settingsPagesPluginsTrendEnabledDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesPluginsTrendText1",
          "pad": 16,
          "size": 13
        }
      },
      {
        "t": "ListTile",
        "k": "/store",
        "p": {
          "title": "@l10n:settingsPagesPluginsTrendStoreTitle",
          "subtitle": "@l10n:settingsPagesPluginsTrendStoreSubtitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
