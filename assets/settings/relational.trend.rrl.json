{
  "schema": "rasq.settings-page/1",
  "area": "relational.trend",
  "title": "@l10n:settingsPagesRelationalTrendTitle",
  "defaults": {},
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesRelationalTrendSection1Title"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "@l10n:settingsPagesRelationalTrendValueRow1Title",
          "value": "@l10n:settingsPagesRelationalTrendValueRow1Value"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesRelationalTrendText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesRelationalTrendText1Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/tlconfig/trend",
        "p": {
          "title": "@l10n:settingsPagesRelationalTrendTlconfigTrendTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
