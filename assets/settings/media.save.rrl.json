{
  "schema": "rasq.settings-page/1",
  "area": "media.save",
  "title": "画像・動画の保存先",
  "defaults": {
    "destination": "ask"
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "全画面表示の「…」/ 共有の「画像を保存」「動画を保存」"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "保存するたびに選ぶ",
          "subtitle": "写真とファイルのどちらに保存するかを、そのたびに聞きます(選べる先が 1 つしかない端末では聞きません)",
          "value": "ask",
          "group": "$.settings.destination"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "写真(カメラロール)",
          "subtitle": "iPhone / iPad / Mac の「写真」、Android のギャラリーの、アルバム「RASQ」に入ります",
          "value": "photos",
          "group": "$.settings.destination"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "ファイル",
          "subtitle": "iPhone / iPad は「ファイル」App の このiPad(このiPhone)› RASQ › 保存。パソコンは保存する場所を選びます。Android はギャラリーに入ります",
          "value": "files",
          "group": "$.settings.destination"
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
