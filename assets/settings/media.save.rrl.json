{
  "schema": "rasq.settings-page/1",
  "area": "media.save",
  "title": "@l10n:settingsPagesMediaSaveTitle",
  "defaults": {
    "destination": "ask"
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesMediaSaveSection1Title"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "@l10n:settingsPagesMediaSaveDestinationAskTitle",
          "subtitle": "@l10n:settingsPagesMediaSaveDestinationAskSubtitle",
          "value": "ask",
          "group": "$.settings.destination",
          "detail": "@l10n:settingsPagesMediaSaveDestinationAskDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "@l10n:settingsPagesMediaSaveDestinationPhotosTitle",
          "subtitle": "@l10n:settingsPagesMediaSaveDestinationPhotosSubtitle",
          "value": "photos",
          "group": "$.settings.destination",
          "detail": "@l10n:settingsPagesMediaSaveDestinationPhotosDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "destination",
        "p": {
          "title": "@l10n:settingsPagesMediaSaveDestinationFilesTitle",
          "subtitle": "@l10n:settingsPagesMediaSaveDestinationFilesSubtitle",
          "value": "files",
          "group": "$.settings.destination",
          "detail": "@l10n:settingsPagesMediaSaveDestinationFilesDetail"
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
