{
  "schema": "rasq.settings-page/1",
  "area": "resources",
  "title": "@l10n:settingsPagesResourcesTitle",
  "defaults": {
    "showAds": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesResourcesSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "showAds",
        "p": {
          "title": "@l10n:settingsPagesResourcesShowAdsTitle",
          "value": "$.settings.showAds",
          "subtitle": "@l10n:settingsPagesResourcesShowAdsSubtitle",
          "detail": "@l10n:settingsPagesResourcesShowAdsDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesResourcesSection2Title"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "@l10n:settingsPagesResourcesValueRow1Title",
          "value": "@l10n:settingsPagesResourcesValueRow1Value"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "@l10n:settingsPagesResourcesValueRow2Title",
          "value": "@l10n:settingsPagesResourcesValueRow2Value"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesResourcesText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesResourcesText1Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/store",
        "p": {
          "title": "@l10n:settingsPagesResourcesStoreTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
