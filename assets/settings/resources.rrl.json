{
  "schema": "rasq.settings-page/1",
  "area": "resources",
  "title": "リソースと広告",
  "defaults": {
    "showAds": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "広告"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "showAds",
        "p": {
          "title": "検索ホームの広告枠を表示",
          "value": "$.settings.showAds",
          "subtitle": "いまの広告枠は表示だけで、広告は出ません",
          "detail": "第一期の広告枠はダミー(「広告」の表示だけ)です。配信は第二期"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SectionHeader",
        "p": {
          "title": "リソース"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "プラグインの通信",
          "value": "端末から直接"
        }
      },
      {
        "t": "ValueListTile",
        "p": {
          "title": "推論",
          "value": "端末の中 + 選んだサーバー"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "プラグインごとの広告の有無と価格は、プラグインストアの各ページに表示されます。",
          "pad": 16,
          "size": 13,
          "detail": "プラグインごとの広告の有無と価格は、プラグインストアの各ページに表示されます。 プラグインの通信: 端末から直接(プロキシ無し)。推論: 端末内モデル(RAi)+ 任意の推論サーバー。"
        }
      },
      {
        "t": "ListTile",
        "k": "/store",
        "p": {
          "title": "プラグインストア"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
