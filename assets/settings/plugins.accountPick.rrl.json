{
  "schema": "rasq.settings-page/1",
  "area": "plugins.accountPick",
  "title": "@l10n:settingsPagesPluginsAccountPickTitle",
  "defaults": {
    "preferCurrent": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesPluginsAccountPickSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "preferCurrent",
        "p": {
          "title": "@l10n:settingsPagesPluginsAccountPickPreferCurrentTitle",
          "value": "$.settings.preferCurrent",
          "subtitle": "@l10n:settingsPagesPluginsAccountPickPreferCurrentSubtitle",
          "detail": "@l10n:settingsPagesPluginsAccountPickPreferCurrentDetail"
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
