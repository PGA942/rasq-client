            {
              "s": "text",
              "text": "\n内容: "
            },
            {
              "s": "text",
              "text": "审查费、积分购买：通过Stripe提供的"
            },
            {
              "s": "text",
              "text": "【实际采用的支付方式】",
              "bold": true,
              "code": true
            },
            {
              "s": "text",
              "text": "。功能购买、续订（正式版）：RASQ 积分"
            }
          ],
          "pad": 16
        }
      },
      {
        "t": "RichText",
        "p": {
          "source": [
            {
              "s": "text",
              "text": "・",
              "bold": true
            },
