{
  "schema": "rasq.settings-page/1",
  "area": "astell.background",
  "title": "@l10n:settingsPagesAstellBackgroundTitle",
  "defaults": {
    "onScreenOff": "keep"
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAstellBackgroundSection1Title"
        }
      },
      {
        "t": "RadioListTile",
        "k": "onScreenOff",
        "p": {
          "title": "@l10n:settingsPagesAstellBackgroundOnScreenOffKeepTitle",
          "value": "keep",
          "group": "$.settings.onScreenOff",
          "subtitle": "@l10n:settingsPagesAstellBackgroundOnScreenOffKeepSubtitle"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "onScreenOff",
        "p": {
          "title": "@l10n:settingsPagesAstellBackgroundOnScreenOffMuteTitle",
          "value": "mute",
          "group": "$.settings.onScreenOff"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "onScreenOff",
        "p": {
          "title": "@l10n:settingsPagesAstellBackgroundOnScreenOffLeaveTitle",
          "value": "leave",
          "group": "$.settings.onScreenOff"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Notice",
        "p": {
          "kind": "info",
          "text": "@l10n:settingsPagesAstellBackgroundNotice1",
          "detail": "@l10n:settingsPagesAstellBackgroundNotice1Detail"
        }
      }
    ]
  }
}
