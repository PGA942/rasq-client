{
  "schema": "rasq.settings-page/1",
  "area": "astell.tiles",
  "title": "@l10n:settingsPagesAstellTilesTitle",
  "defaults": {
    "headerStrip": true,
    "headerMax": 4
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAstellTilesSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "headerStrip",
        "p": {
          "title": "@l10n:settingsPagesAstellTilesHeaderStripTitle",
          "value": "$.settings.headerStrip",
          "subtitle": "@l10n:settingsPagesAstellTilesHeaderStripSubtitle",
          "detail": "@l10n:settingsPagesAstellTilesHeaderStripDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SliderListTile",
        "k": "headerMax",
        "p": {
          "title": "@l10n:settingsPagesAstellTilesHeaderMaxTitle",
          "value": "$.settings.headerMax",
          "min": 1,
          "max": 8,
          "divisions": 7,
          "unit": "@l10n:settingsPagesAstellTilesHeaderMaxUnit"
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
