{
  "schema": "rasq.settings-page/1",
  "area": "about.developer",
  "title": "@l10n:settingsPagesAboutDeveloperTitle",
  "defaults": {
    "enabled": false,
    "iosScreenGlimpse": false,
    "raiAndroid3d": false
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SwitchListTile",
        "k": "enabled",
        "p": {
          "title": "@l10n:settingsPagesAboutDeveloperTitle",
          "value": "$.settings.enabled",
          "subtitle": "@l10n:settingsPagesAboutDeveloperEnabledSubtitle",
          "detail": "@l10n:settingsPagesAboutDeveloperEnabledDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Notice",
        "p": {
          "kind": "info",
          "text": "@l10n:settingsPagesAboutDeveloperNotice1"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "iosScreenGlimpse",
        "p": {
          "title": "@l10n:settingsPagesAboutDeveloperIosScreenGlimpseTitle",
          "value": "$.settings.iosScreenGlimpse",
          "subtitle": "@l10n:settingsPagesAboutDeveloperIosScreenGlimpseSubtitle",
          "detail": "@l10n:settingsPagesAboutDeveloperIosScreenGlimpseDetail",
          "dev": true
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "raiAndroid3d",
        "p": {
          "title": "@l10n:settingsPagesAboutDeveloperRaiAndroid3dTitle",
          "value": "$.settings.raiAndroid3d",
          "subtitle": "@l10n:settingsPagesAboutDeveloperRaiAndroid3dSubtitle",
          "detail": "@l10n:settingsPagesAboutDeveloperRaiAndroid3dDetail",
          "dev": true
        },
        "on": {
          "change": "settings.set"
        }
      }
    ]
  }
}
