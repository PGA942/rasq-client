{
  "schema": "rasq.settings-page/1",
  "area": "appearance.display",
  "title": "@l10n:settingsPagesAppearanceDisplayTitle",
  "defaults": { "textScale": 100 },
  "root": {
    "t": "Column",
    "c": [
      { "t": "SectionHeader", "p": { "title": "@l10n:settingsPagesAppearanceDisplaySection1Title" } },
      {
        "t": "SliderListTile",
        "k": "textScale",
        "p": {
          "title": "@l10n:settingsPagesAppearanceDisplayTextScaleTitle",
          "subtitle": "@l10n:settingsPagesAppearanceDisplayTextScaleSubtitle",
          "value": "$.settings.textScale",
          "min": 85,
          "max": 130,
          "divisions": 9,
          "unit": "%"
        },
        "on": { "change": "settings.set" }
      }
    ]
  }
}
