{
  "schema": "rasq.settings-page/1",
  "area": "appearance.notifications",
  "title": "@l10n:settingsPagesAppearanceNotificationsTitle",
  "defaults": {
    "defaultTab": "all",
    "showReminders": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAppearanceNotificationsSection1Title"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultTab",
        "p": {
          "title": "@l10n:settingsPagesAppearanceNotificationsDefaultTabAllTitle",
          "value": "all",
          "group": "$.settings.defaultTab"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "defaultTab",
        "p": {
          "title": "@l10n:settingsPagesAppearanceNotificationsDefaultTabFollowingTitle",
          "value": "following",
          "group": "$.settings.defaultTab",
          "subtitle": "@l10n:settingsPagesAppearanceNotificationsDefaultTabFollowingSubtitle"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "showReminders",
        "p": {
          "title": "@l10n:settingsPagesAppearanceNotificationsShowRemindersTitle",
          "value": "$.settings.showReminders",
          "subtitle": "@l10n:settingsPagesAppearanceNotificationsShowRemindersSubtitle",
          "detail": "@l10n:settingsPagesAppearanceNotificationsShowRemindersDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesAppearanceNotificationsText1",
          "pad": 16,
          "size": 13
        }
      }
    ]
  }
}
