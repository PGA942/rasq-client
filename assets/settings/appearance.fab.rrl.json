{
  "schema": "rasq.settings-page/1",
  "area": "appearance.fab",
  "title": "＋ ボタンの割り当て",
  "defaults": {
    "homeTap": "post",
    "trendTap": "post",
    "astellTap": "astell"
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "Notice",
        "p": {
          "kind": "info",
          "text": "＋ を押したときに始めるものを選べます。まわりのボタン(内側に 3 つ、外側に 4 つまで)は、＋ を長押し(マウスは乗せる)して歯車から並べ替えます。",
          "detail": "D-383 / D-385。領域 appearance.fab(<scope>Tap / <scope>Slots = 置いた順、最大 7)。"
        }
      },
      {
        "t": "SectionHeader",
        "p": {
          "title": "ホームの ＋ を押したとき"
        }
      },
      {
        "t": "RadioListTile",
        "k": "homeTap",
        "p": {
          "title": "投稿",
          "value": "post",
          "group": "$.settings.homeTap"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "homeTap",
        "p": {
          "title": "RASQ に投稿",
          "value": "rasq",
          "group": "$.settings.homeTap"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "homeTap",
        "p": {
          "title": "Swing を作る",
          "value": "swing",
          "group": "$.settings.homeTap"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "RadioListTile",
        "k": "homeTap",
