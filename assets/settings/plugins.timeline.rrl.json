{
  "schema": "rasq.settings-page/1",
  "area": "plugins.timeline",
  "title": "@l10n:settingsPagesPluginsTimelineTitle",
  "defaults": {
    "enabled": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesPluginsTimelineSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "enabled",
        "p": {
          "title": "@l10n:settingsPagesPluginsTimelineEnabledTitle",
          "value": "$.settings.enabled",
          "subtitle": "@l10n:settingsPagesPluginsTimelineEnabledSubtitle",
          "detail": "@l10n:settingsPagesPluginsTimelineEnabledDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesPluginsTimelineText1",
          "pad": 16,
          "size": 13
        }
      },
      {
        "t": "ListTile",
        "k": "/store",
        "p": {
          "title": "@l10n:settingsPagesPluginsTimelineStoreTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
