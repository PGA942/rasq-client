{
  "schema": "rasq.settings-page/1",
  "area": "plugins.composer",
  "title": "@l10n:settingsPagesPluginsComposerTitle",
  "defaults": {
    "enabled": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesPluginsComposerSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "enabled",
        "p": {
          "title": "@l10n:settingsPagesPluginsComposerEnabledTitle",
          "value": "$.settings.enabled",
          "subtitle": "@l10n:settingsPagesPluginsComposerEnabledSubtitle",
          "detail": "@l10n:settingsPagesPluginsComposerEnabledDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesPluginsComposerText1",
          "pad": 16,
          "size": 13
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/composer",
        "p": {
          "title": "@l10n:settingsPagesPluginsComposerSettingsComposerTitle"
        },
        "on": {
          "tap": "route.push"
        }
      },
      {
        "t": "ListTile",
        "k": "/store",
        "p": {
          "title": "@l10n:settingsPagesPluginsComposerStoreTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
