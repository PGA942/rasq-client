              "bold": true
            },
            {
              "s": "text",
              "text": "Additional costs",
              "bold": true
            },
            {
              "s": "text",
              "text": "\nDetails: "
            },
            {
              "s": "text",
              "text": "Communication charges, and fees for external SNSs, inference servers, etc. separately contracted by the user. For proxy contracts essential to a product, the name and fee are also shown"
            }
          ],
          "pad": 16
        }
      },
