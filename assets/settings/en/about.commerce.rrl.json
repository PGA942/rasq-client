              "text": "Payment methods",
              "bold": true
            },
            {
              "s": "text",
              "text": "\nDetails: "
            },
            {
              "s": "text",
              "text": "Review fees and point purchases: "
            },
            {
              "s": "text",
              "text": "【payment methods actually adopted】",
              "bold": true,
              "code": true
            },
            {
              "s": "text",
              "text": " provided through Stripe. Feature purchases and renewals (official version): RASQ Points"
            }
          ],
          "pad": 16
        }
      },
      {
        "t": "RichText",
        "p": {
          "source": [
            {
              "s": "text",
              "text": "・",
              "bold": true
            },
            {
              "s": "text",
              "text": "Payment timing",
              "bold": true
            },
            {
              "s": "text",
              "text": "\nDetails: "
            },
            {
              "s": "text",
              "text": "Review fees: at the time of application (when payment is confirmed). Point purchases: when payment is confirmed. Feature purchases: at the same time as the grant of usage rights; subscriptions: at the start of each displayed period"
            }
          ],
          "pad": 16
        }
      },
