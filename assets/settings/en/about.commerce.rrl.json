        "p": {
          "source": [
            {
              "s": "text",
              "text": "・",
              "bold": true
            },
            {
              "s": "text",
              "text": "Delivery timing",
              "bold": true
            },
            {
              "s": "text",
              "text": "\nDetails: "
            },
            {
              "s": "text",
              "text": "Review fees: review begins within "
            },
            {
              "s": "text",
              "text": "【TBD: 30 days】",
              "bold": true,
              "code": true
            },
            {
              "s": "text",
              "text": " of acceptance of the application, and the result is notified within "
