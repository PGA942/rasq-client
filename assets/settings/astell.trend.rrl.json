{
  "schema": "rasq.settings-page/1",
  "area": "astell.trend",
  "title": "@l10n:settingsPagesAstellTrendTitle",
  "defaults": {
    "showTrending": true,
    "showRecommended": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAstellTrendSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "showRecommended",
        "p": {
          "title": "@l10n:settingsPagesAstellTrendShowRecommendedTitle",
          "value": "$.settings.showRecommended"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "showTrending",
        "p": {
          "title": "@l10n:settingsPagesAstellTrendShowTrendingTitle",
          "value": "$.settings.showTrending",
          "subtitle": "@l10n:settingsPagesAstellTrendShowTrendingSubtitle"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesAstellTrendText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesAstellTrendText1Detail"
        }
      },
      {
        "t": "ListTile",
        "k": "/tlconfig/trend",
        "p": {
          "title": "@l10n:settingsPagesAstellTrendTlconfigTrendTitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
