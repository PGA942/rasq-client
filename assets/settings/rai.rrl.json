{
  "schema": "rasq.settings-page/1",
  "area": "rai",
  "title": "@l10n:settingsPagesRaiTitle",
  "defaults": {
    "traceGraphAuto": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesRaiSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "traceGraphAuto",
        "p": {
          "title": "@l10n:settingsPagesRaiTraceGraphAutoTitle",
          "subtitle": "@l10n:settingsPagesRaiTraceGraphAutoSubtitle",
          "value": "$.settings.traceGraphAuto",
          "detail": "@l10n:settingsPagesRaiTraceGraphAutoDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "@l10n:settingsPagesRaiText1",
          "pad": 16,
          "size": 13,
          "detail": "@l10n:settingsPagesRaiText1Detail"
        }
      }
    ]
  }
}
