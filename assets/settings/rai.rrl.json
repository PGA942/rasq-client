{
  "schema": "rasq.settings-page/1",
  "area": "rai",
  "title": "RAi(アシスタント)",
  "defaults": {
    "traceGraphAuto": true
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "自動化"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "traceGraphAuto",
        "p": {
          "title": "工程グラフを自動で表示",
          "subtitle": "3 手順以上の自動化を、グラフで表示します",
          "value": "$.settings.traceGraphAuto",
          "detail": "RAi に任せた自動化が 3 手順以上のとき、工程をノードのグラフで自動表示します。オフなら「グラフビューで表示」ボタンになります"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "Text",
        "p": {
          "text": "AI のモデルや web 検索は、RAi バーのモデルのボタンから設定します。",
          "pad": 16,
          "size": 13,
          "detail": "推論サーバーや web 検索の鍵は RAi バーのモデルチップから設定します。"
        }
      }
    ]
  }
}
