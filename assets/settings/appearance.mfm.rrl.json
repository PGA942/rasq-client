{
  "schema": "rasq.settings-page/1",
  "area": "appearance.mfm",
  "title": "@l10n:settingsPagesAppearanceMfmTitle",
  "defaults": {
    "animations": true,
    "speed": 100
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "@l10n:settingsPagesAppearanceMfmSection1Title"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "animations",
        "p": {
          "title": "@l10n:settingsPagesAppearanceMfmAnimationsTitle",
          "value": "$.settings.animations",
          "subtitle": "@l10n:settingsPagesAppearanceMfmAnimationsSubtitle",
          "detail": "@l10n:settingsPagesAppearanceMfmAnimationsDetail"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SliderListTile",
        "k": "speed",
        "p": {
          "title": "@l10n:settingsPagesAppearanceMfmSpeedTitle",
          "value": "$.settings.speed",
          "min": 50,
          "max": 200,
          "divisions": 6,
          "unit": "%",
          "subtitle": "@l10n:settingsPagesAppearanceMfmSpeedSubtitle"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/dsl/appearance.motion",
        "p": {
          "title": "@l10n:settingsPagesAppearanceMfmSettingsDslAppearanceMotionTitle",
          "subtitle": "@l10n:settingsPagesAppearanceMfmSettingsDslAppearanceMotionSubtitle"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
