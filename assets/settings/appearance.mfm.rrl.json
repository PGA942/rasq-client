{
  "schema": "rasq.settings-page/1",
  "area": "appearance.mfm",
  "title": "カスタムモーションとアニメーション",
  "defaults": {
    "animations": true,
    "speed": 100
  },
  "root": {
    "t": "Column",
    "c": [
      {
        "t": "SectionHeader",
        "p": {
          "title": "MFM のアニメーション"
        }
      },
      {
        "t": "SwitchListTile",
        "k": "animations",
        "p": {
          "title": "動く装飾を再生する",
          "value": "$.settings.animations",
          "subtitle": "回転や虹色などの動く装飾を再生します",
          "detail": "spin / jump / rainbow などの MFM を動かします。オフにすると静止画になります(「モーションの抑制」がオンのときは常に静止)"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "SliderListTile",
        "k": "speed",
        "p": {
          "title": "アニメーションの速さ",
          "value": "$.settings.speed",
          "min": 50,
          "max": 200,
          "divisions": 6,
          "unit": "%",
          "subtitle": "100% が標準。大きいほど速く動きます"
        },
        "on": {
          "change": "settings.set"
        }
      },
      {
        "t": "ListTile",
        "k": "/settings/dsl/appearance.motion",
        "p": {
          "title": "モーションの抑制",
          "subtitle": "画面遷移なども含めてまとめて減らす"
        },
        "on": {
          "tap": "route.push"
        }
      }
    ]
  }
}
